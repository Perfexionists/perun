{% import 'macros/section_title.html.jinja2' as m_title %}

{% set graphs_info = "This section combines Flame Graphs and Tree Maps for a unified view of
    resource consumption.

    Flame graphs show consumption of functions aggregated by unique
    calling-contexts (i.e., stack traces). Clicking on a rectangle will zoom the flame graph.
    Each rectangle represents a function in a specific calling-context: parent rectangles represent
    caller functions and nested rectangles represent callees. The rectangle width corresponds to its
    inclusive consumption. In the exclusive view, a colored and scaled overlay rectangle contrasts
    the exclusive and inclusive consumptions. Colors in non-differential flame graphs are picked
    randomly but uniformly; they do not represent any metric.

    Tree Maps show consumption of functions aggregated across all calling-contexts (i.e., stack
    traces). The maps avoid hierarchy; use flame graphs if you need to see the calling-contexts of
    individual functions. Thus, compared to flame graphs, there is no (un)zoom action on tree map
    rectangles. Each rectangle represents one function and its size is scaled w.r.t. to the
    absolute consumption. In the inclusive view, the percentages will generally add up to >= 100%.
    In the exclusive view, the percentages should add up to <= 100%.

    Difference graphs draw rectangles scaled w.r.t. to the absolute consumption in baseline or
    target, respectively, and not the consumption delta which is instead represented using a
    color hue." %}

<div id="graphs" class="section">

    {{ m_title.display_title("Graphs", "graphs", graphs_info, notes_enabled=notes_enabled) }}

    {%- for (metric, lhs_flamegraph, rhs_flamegraph, lhs_diff_flamegraph, rhs_diff_flamegraph) in flamegraphs %}

    <!-- Diff Grid -->
    <div id="graphs-diff" class="graph-grid">
        <div class="grid_search_box" style="gap: 70px; margin-top: 30px;">
            <div class="grid_search_box">
                <span>Layout: </span>
                <span id="diff_graph_layout_switch" class="grid_layout_switch">
                    <span class="svg_switch_container visible">
                        {% include 'assets/grid_view.svg' %}
                    </span>
                    <span class="svg_switch_container hidden">
                        {% include 'assets/row_view.svg' %}
                    </span>
                </span>
            </div>

            <div class="grid_search_box">
                <label for="diff_graph_search_all" class="grid_search_input_label">Global Search:</label>
                <input id="diff_graph_search_all" class="dt-input" />
                <button id="diff_graph_search_reset_all" class="grid_btn">Reset Global Search</button>
                <button id="diff_graph_zoom_reset_all" class="grid_btn">Unzoom All</button>
                <button id="diff_graph_toggle_ie_all" class="grid_btn">Show Inclusive Consumption</button>
                <button id="diff_graph_toggle_highlight_all" class="grid_btn">Highlight New/Deleted</button>
            </div>
        </div>

        <div class="comparison_container comparison_container_non_scale comparison_container_stacked">
            <div class="left column column_non_scale column_extended">
                <div class='grid-svg-container' id="flame_diff_{{ loop.index0 }}_baseline">
                    <div class="panel-drag-handle" title="Drag to swap with another graph"></div>
                {{ lhs_diff_flamegraph }}
                </div>
            </div>
            <div class="right column column_non_scale column_extended">
                <div class='grid-svg-container' id="flame_diff_{{ loop.index0 }}_target">
                    <div class="panel-drag-handle" title="Drag to swap with another graph"></div>
                {{ rhs_diff_flamegraph }}
                </div>
            </div>
        </div>

        <div class="comparison_container comparison_container_non_scale comparison_container_stacked">
            <div class="left column column_non_scale column_extended" style="margin-top: 1%">
                <div class="grid-svg-container treemap-panel" id="treemap-baseline-diff">
                    <div class="panel-drag-handle" title="Drag to swap with another graph"></div>
                    <svg preserveAspectRatio="xMinYMin meet" viewBox="0 0 800 500"></svg>
                </div>
            </div>
            <div class="right column column_non_scale column_extended" style="margin-top: 1%">
                <div class="grid-svg-container treemap-panel" id="treemap-target-diff">
                    <div class="panel-drag-handle" title="Drag to swap with another graph"></div>
                    <svg preserveAspectRatio="xMinYMin meet" viewBox="0 0 800 500"></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Non-diff Grid -->
    <div id="graphs-nondiff" class="graph-grid">
        <div class="grid_search_box" style="gap: 70px; margin-top: 30px;">
            <div class="grid_search_box">
                <span>Layout: </span>
                <span id="nondiff_graph_layout_switch" class="grid_layout_switch">
                    <span class="svg_switch_container visible">
                        {% include 'assets/grid_view.svg' %}
                    </span>
                    <span class="svg_switch_container hidden">
                        {% include 'assets/row_view.svg' %}
                    </span>
                </span>
            </div>

            <div class="grid_search_box">
                <label for="nondiff_graph_search_all" class="grid_search_input_label">Global Search:</label>
                <input id="nondiff_graph_search_all" class="dt-input" />
                <button id="nondiff_graph_search_reset_all" class="grid_btn">Reset Global Search</button>
                <button id="nondiff_graph_zoom_reset_all" class="grid_btn">Unzoom All</button>
                <button id="nondiff_graph_toggle_ie_all" class="grid_btn">Show Exclusive Consumption</button>
                <button id="nondiff_graph_toggle_highlight_all" class="grid_btn">Highlight New/Deleted</button>
            </div>
        </div>

        <div class="comparison_container comparison_container_non_scale comparison_container_stacked">
            <div class="left column column_non_scale column_extended">
                <div class='grid-svg-container' id="flame_{{ loop.index0 }}_baseline">
                    <div class="panel-drag-handle" title="Drag to swap with another graph"></div>
                {{ lhs_flamegraph }}
                </div>
            </div>
            <div class="right column column_non_scale column_extended">
                <div class='grid-svg-container' id="flame_{{ loop.index0 }}_target">
                    <div class="panel-drag-handle" title="Drag to swap with another graph"></div>
                {{ rhs_flamegraph }}
                </div>
            </div>
        </div>

        <div class="comparison_container comparison_container_non_scale comparison_container_stacked">
            <div class="left column column_non_scale column_extended" style="margin-top: 1%">
                <div class="grid-svg-container treemap-panel" id="treemap-baseline">
                    <div class="panel-drag-handle" title="Drag to swap with another graph"></div>
                    <svg preserveAspectRatio="xMinYMin meet" viewBox="0 0 800 500"></svg>
                </div>
            </div>
            <div class="right column column_non_scale column_extended" style="margin-top: 1%">
                <div class="grid-svg-container treemap-panel" id="treemap-target">
                    <div class="panel-drag-handle" title="Drag to swap with another graph"></div>
                    <svg preserveAspectRatio="xMinYMin meet" viewBox="0 0 800 500"></svg>
                </div>
            </div>
        </div>
    </div>

    {%- endfor %}
</div>
