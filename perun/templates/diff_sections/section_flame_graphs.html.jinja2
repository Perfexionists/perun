{% import 'macros/section_title.html.jinja2' as m_title %}

{% set flame_graphs_info = "Flame graphs show consumption of functions aggregated by unique
    calling-contexts (i.e., stack traces).

    Flame graphs are interactive; clicking on a rectangle will zoom the flame graph.

    Each rectangle represents a function in a specific calling-context: parent rectangles represent
    caller functions and nested rectangles represent callees. The higher a particular tower is, the
    more nested calls there are.

    The rectangle width corresponds to its inclusive consumption. Rectangles that are too narrow to
    properly render are filtered out.

    In the exclusive view, a colored and scaled overlay rectangle contrasts the exclusive and
    inclusive consumptions.

    Colors in non-differential flame graphs are picked randomly but uniformly; they do not
    represent any metric.

    Difference flame graphs draw rectangles scaled w.r.t. to the absolute consumption in baseline
    or target, respectively, and not the consumption delta which is instead represented using a
    color hue." %}

<div id="flame" class="section">

    {{ m_title.display_title("Flame Graphs", "flame graphs", flame_graphs_info, notes_enabled=notes_enabled) }}

    <div class="grid_search_box" style="gap: 70px; margin-top: 30px;">
        <div class="grid_search_box">
            <span>Layout: </span>
            <span id="flamegraph_layout_switch" class="grid_layout_switch">
                <span class="svg_switch_container visible">
                    {% include 'assets/grid_view.svg' %}
                </span>
                <span class="svg_switch_container hidden">
                    {% include 'assets/row_view.svg' %}
                </span>
            </span>
        </div>

        <div class="grid_search_box">
            <label for="flamegraph_search_all" class="grid_search_input_label">Global Search:</label>
            <input id="flamegraph_search_all" class="dt-input" />
            <button id="flamegraph_search_reset_all" class="grid_btn">Reset Global Search</button>
            <button id="flamegraph_zoom_reset_all" class="grid_btn">Unzoom All</button>
            <button id="flamegraph_toggle_ie_all" class="grid_btn">Show Exclusive Consumption</button>
        </div>
    </div>

    {%- for (metric, lhs_flamegraph, rhs_flamegraph, lhs_diff_flamegraph, rhs_diff_flamegraph) in flamegraphs %}

        <div class="comparison_container comparison_container_non_scale comparison_container_stacked">
            <div class="left column column_non_scale column_extended">
                <div class='svg-container' id="flame_{{ loop.index0 }}_baseline">
                {{ lhs_flamegraph }}
                </div>
            </div>
            <div class="right column column_non_scale column_extended">
                <div class='svg-container' id="flame_{{ loop.index0 }}_target">
                {{ rhs_flamegraph }}
                </div>
            </div>
        </div>

        <div class="comparison_container comparison_container_non_scale comparison_container_stacked">
            <div class="left column column_non_scale column_extended" style="margin-top: 1%">
                <div class='svg-container' id="flame_diff_{{ loop.index0 }}_baseline">
                {{ lhs_diff_flamegraph }}
                </div>
            </div>
            <div class="right column column_non_scale column_extended" style="margin-top: 1%">
                <div class='svg-container' id="flame_diff_{{ loop.index0 }}_target">
                {{ rhs_diff_flamegraph }}
                </div>
            </div>
        </div>
    {%- endfor %}
</div>