{% import 'macros/comparison_table.html.jinja2' as m_tables %}
{% import 'macros/titles.html.jinja2' as titles %}
{% import 'macros/rating_slider.html.jinja2' as summary_tools %}

{% set STATS_NOTE_TITLE = "summary" %}

<div class="section" id="summary">

    <div class="comparison_container">

        {% set metric_names = [
            'Total Inclusive Samples  [#] (value)',
            'bogo-ops-per-second-real-time [op/s] (value)',
            'Longest Profile Trace [#] (value)',
            'Longest Flame Graph Trace [#] (value)'
            ]
        %}
        {% set number_of_summary_metrics = 2 %}

        {% set ns = namespace(count=1) %}
        {% for metric in metric_names[:number_of_summary_metrics] %}

            {% set l_fg_sample = (lhs_fg_stats | selectattr(0, 'in', metric) | list | first) %}
            {% set r_fg_sample = (rhs_fg_stats | selectattr(0, 'in', metric) | list | first) %}

            {% set l_user_sample = (lhs_user_stats | selectattr(0, 'in', metric) | list | first) %}
            {% set r_user_sample = (rhs_user_stats | selectattr(0, 'in', metric) | list | first) %}

            {% if l_fg_sample and r_fg_sample %}
                {{ summary_tools.rating_slider(ns.count, metric, l_fg_sample, r_fg_sample) }}
                {% set ns.count = ns.count + 1 %}
            {% endif %}

            {% if l_user_sample and r_user_sample %}
                {{ summary_tools.rating_slider(ns.count, metric, l_user_sample, r_user_sample) }}
                {% set ns.count = ns.count + 1 %}
            {% endif %}

        {% endfor %}

    </div>

    <div class="comparison_container">
        <div class="column">
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Top 5 Baseline-Only Functions</h2>
            <div class="data-row">
                <div class="data-key">search_binary_handler</div>
                <div style="font-weight: bold" class="data-value">-3.132G</div>
            </div>
            <div class="data-row">
                <div class="data-key">perf_event_exec</div>
                <div style="font-weight: bold" class="data-value">-204.375K</div>
            </div>
            <div class="data-row">
                <div class="data-key">perf_ctx_unlock</div>
                <div style="font-weight: bold" class="data-value">-50.123M</div>
            </div>
            <div class="data-row">
                <div class="data-key">perf_event_addr_filters_exec</div>
                <div style="font-weight: bold" class="data-value">-189.485K</div>
            </div>
            <div class="data-row">
                <div class="data-key">mnt_want_write</div>
                <div style="font-weight: bold" class="data-value">-1.787M</div>
            </div>
        </div>

        <div class="column">
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Top 5 Common Functions</h2>
            <div class="data-row">
                <div class="data-key">__x64_sys_exit_group</div>
                <div style="font-weight: bold" class="data-value">8.182G <span style="color: #ef4444; margin-left: 8px;"> +84.51%</span></div>
            </div>
            <div class="data-row">
                <div class="data-key">do_group_exit</div>
                <div style="font-weight: bold" class="data-value">8.181G <span style="color: #ef4444; margin-left: 8px;"> +84.51%</span></div>
            </div>
            <div class="data-row">
                <div class="data-key">do_exit</div>
                <div style="font-weight: bold" class="data-value">8.172G <span style="color: #ef4444; margin-left: 8px;"> +84.49%</span></div>
            </div>
            <div class="data-row">
                <div class="data-key">x64_sys_call</div>
                <div style="font-weight: bold" class="data-value">7.887G <span style="color: #ef4444; margin-left: 8px;"> +80.70%</span></div>
            </div>
            <div class="data-row">
                <div class="data-key">exit_mm</div>
                <div style="font-weight: bold" class="data-value">7.764G <span style="color: #ef4444; margin-left: 8px;"> +84.93%</span></div>
            </div>
        </div>

        <div class="column">
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Top 5 Target-Only Functions</h2>
            <div class="data-row">
                <div class="data-key">zap_present_ptes.constprop.0</div>
                <div style="font-weight: bold" class="data-value">2.377G</div>
            </div>
            <div class="data-row">
                <div class="data-key">__alloc_frozen_pages_noprof</div>
                <div style="font-weight: bold" class="data-value">730.417M</div>
            </div>
            <div class="data-row">
                <div class="data-key">alloc_pages_mpol</div>
                <div style="font-weight: bold" class="data-value">682.113M</div>
            </div>
            <div class="data-row">
                <div class="data-key">free_frozen_page_commit</div>
                <div style="font-weight: bold" class="data-value">108.589M</div>
            </div>
            <div class="data-row">
                <div class="data-key">free_frozen_pages</div>
                <div style="font-weight: bold" class="data-value">41.203M</div>
            </div>
        </div>
    </div>
</div>