{% import 'macros/overview.html.jinja2' as o_macros %}
{% import 'macros/comparison_table.html.jinja2' as m_tables %}
{% import 'macros/titles.html.jinja2' as titles %}
{% import 'macros/rating_slider.html.jinja2' as summary_tools %}
{% import 'macros/traces_selection.html.jinja2' as traces_selection %}
{% import 'macros/section_title.html.jinja2' as m_title %}
{% import 'macros/pin.html.jinja2' as m_pin %}

{% set STATS_NOTE_TITLE = "overview" %}

<div class="section" id="overview">
    {{ m_title.display_title("Perun Performance Report", "overview") }}

    {% if chatbot %}
    <button id="llm-summary-button" class="llm-summary-button" type="button"
            onclick="generateReportSummary()">
        <span aria-hidden="true">✨</span> AI summary
    </button>
    <section class="llm-summary" id="llm-summary" aria-labelledby="llm-summary-title" hidden>
        <div class="llm-summary__header">
            <h2 id="llm-summary-title">AI summary</h2>
        </div>
        <div id="llm-summary-output" class="llm-summary__output" role="status" aria-live="polite"></div>
    </section>
    {% endif %}

    <div class="comparison_container">

        {% set user_names = (lhs_user_stats + rhs_user_stats) | map(attribute=0) | unique | sort | list %}
        
        {% set max_metrics = 3 %}
        {% set selected_user_names = user_names[:max_metrics] %}
        
        {% set remaining_slots = max_metrics - (selected_user_names | length) %}
        {% set selected_implicit_names = [] %}
        
        {% if remaining_slots > 0 %}
            {% set implicit_unique = (lhs_fg_stats + rhs_fg_stats) | map(attribute=0) | unique | list %}
            
            {% set prio_list = [
                'Total samples [#] (value)',
                'Measured Functions [#] (value)',
                'Unique Functions [#] (value)',
                'Measured Traces [#] (value)',
                'Unique Traces [#] (value)',
                'Longest Profile Trace [#] (value)',
                'Total Inclusive Samples  [#] (value)',
                'Longest Flame Graph Trace [#] (value)'
            ] %}
            
            {% set ordered_implicit = [] %}
            {% for p in prio_list %}
                {% if p in implicit_unique %}
                    {% set _ = ordered_implicit.append(p) %}
                {% endif %}
            {% endfor %}
            
            {% set selected_implicit_names = ordered_implicit[:remaining_slots] %}
        {% endif %}

        {% set ns = namespace(count=1) %}
        
        {# Render user metrics first #}
        {% for metric in selected_user_names %}
            {% set l_user_sample = (lhs_user_stats | selectattr(0, 'equalto', metric) | list | first) %}
            {% set r_user_sample = (rhs_user_stats | selectattr(0, 'equalto', metric) | list | first) %}

            {% if not l_user_sample %}
                {% set l_user_sample = (lhs_user_stats | selectattr(0, 'in', metric) | list | first) %}
            {% endif %}
            {% if not r_user_sample %}
                {% set r_user_sample = (rhs_user_stats | selectattr(0, 'in', metric) | list | first) %}
            {% endif %}

            {% if l_user_sample and r_user_sample %}
                {{ summary_tools.rating_slider(ns.count, metric, l_user_sample, r_user_sample) }}
                {% set ns.count = ns.count + 1 %}
            {% endif %}
        {% endfor %}

        {# Render implicit metrics next #}
        {% for metric in selected_implicit_names %}
            {% set l_fg_sample = (lhs_fg_stats | selectattr(0, 'equalto', metric) | list | first) %}
            {% set r_fg_sample = (rhs_fg_stats | selectattr(0, 'equalto', metric) | list | first) %}

            {% if not l_fg_sample %}
                {% set l_fg_sample = (lhs_fg_stats | selectattr(0, 'in', metric) | list | first) %}
            {% endif %}
            {% if not r_fg_sample %}
                {% set r_fg_sample = (rhs_fg_stats | selectattr(0, 'in', metric) | list | first) %}
            {% endif %}

            {% if l_fg_sample and r_fg_sample %}
                {{ summary_tools.rating_slider(ns.count, metric, l_fg_sample, r_fg_sample) }}
                {% set ns.count = ns.count + 1 %}
            {% endif %}
        {% endfor %}

    </div>

    {{ o_macros.top_diff_section('Top Functions', 'top-funcs', 'onFunctionsInclExclToggle()') }}
    {{ o_macros.top_diff_section('Top Traces', 'top-traces', 'onTracesInclExclToggle()') }}

</div>

<script>
    const topTraceDiffs = [
        /* Top traces w.r.t. INCLUSIVE proportional delta */
        [
            /*
             [0]: deleted from baseline,
             [1]: added to target,
             [2]: present in both profiles and the largest increase,
             [3]: present in both profiles and the largest decrease.
            */
            {{ o_macros.populate_top_diffs(top_diffs_trace_inclusive) }}
        ],
        /* Top traces w.r.t. EXCLUSIVE proportional delta */
        [
            /*
             [0]: deleted from baseline,
             [1]: added to target,
             [2]: present in both profiles and the largest increase,
             [3]: present in both profiles and the largest decrease.
            */
            {{ o_macros.populate_top_diffs(top_diffs_trace_exclusive) }}
        ]
    ];

    const topFunctionDiffs = [
        /* Top functions w.r.t. INCLUSIVE proportional delta */
        [
            /*
             [0]: deleted from baseline,
             [1]: added to target,
             [2]: present in both profiles and the largest increase,
             [3]: present in both profiles and the largest decrease.
            */
            {{ o_macros.populate_top_diffs(top_diffs_func_inclusive) }}
        ],
        /* Top functions w.r.t. EXCLUSIVE proportional delta */
        [
            /*
             [0]: deleted from baseline,
             [1]: added to target,
             [2]: present in both profiles and the largest increase,
             [3]: present in both profiles and the largest decrease.
            */
            {{ o_macros.populate_top_diffs(top_diffs_func_exclusive) }}
        ]
    ];

    /**
     * Shared DOM builder for Top-diff rows (functions and traces).
     * @param {string} containerId - Target container element ID.
     * @param {Array} dataArray - Array of [symbol, diffValue] pairs.
     * @param {function} rowConfig - Called with (row, index); must return { label, tooltip, onClick }.
     */
    function renderDiffTable(containerId, dataArray, rowConfig) {
        const container = document.getElementById(containerId);
        container.innerHTML = '';
        if (!dataArray || dataArray.length === 0) {
            container.innerHTML = '<div style="font-style: italic; color: #888; padding: 10px;">No data</div>';
            return;
        }
        dataArray.forEach((row, index) => {
            const rowDiv = document.createElement('div');
            rowDiv.className = 'data-row';

            const keyWrapper = document.createElement('div');
            keyWrapper.className = 'data-key-wrapper';

            const idxSpan = document.createElement('span');
            idxSpan.className = 'data-idx';
            idxSpan.textContent = `${index + 1}.`;

            const keyDiv = document.createElement('div');
            keyDiv.className = 'data-key';

            const { label, tooltip, onClick } = rowConfig(row, index);
            keyDiv.title = tooltip;
            keyDiv.textContent = label;
            keyDiv.onclick = onClick;

            keyWrapper.appendChild(idxSpan);
            keyWrapper.appendChild(keyDiv);

            const valDiv = document.createElement('div');
            valDiv.className = 'data-value';

            const value = row[1];
            const sign = value > 0 ? '+' : '';
            const colorClass = value >= 0 ? 'diff-minus' : 'diff-plus';
            valDiv.innerHTML = `<span class="${colorClass}" style="margin-left: 8px; font-weight: bold;">${sign}${value.toFixed(2)}%</span>`;

            rowDiv.appendChild(keyWrapper);
            rowDiv.appendChild(valDiv);
            container.appendChild(rowDiv);
        });
    }

    function renderFunctionsTable(containerId, dataArray) {
        renderDiffTable(containerId, dataArray, (row, index) => {
            const funcName = nodes[row[0]] || row[0];
            return {
                label: funcName,
                tooltip: funcName,
                onClick: () => {
                    const rowData = findTraceDataBySymbol(row[0]);
                    if (rowData && window.openTracePopup) {
                        const isExcl = getSectionInclExclIndex('top-funcs') === 1;
                        window.openTracePopup(rowData, isExcl, {
                            items: dataArray,
                            currentIndex: index,
                            isExclusive: isExcl,
                        });
                    }
                },
            };
        });
    }

    function renderTracesTable(containerId, dataArray) {
        renderDiffTable(containerId, dataArray, (row, index) => {
            const traceStr = row[0];
            const ids = traceStr.split(';');
            // Folded format is root;...;leaf — the rightmost ID is the leaf (top of call stack).
            const leafId = ids[ids.length - 1];
            const leafName = nodes[parseInt(leafId)] || leafId;
            // Tooltip shows the call chain from leaf down to root, matching the modal's call stack panel.
            const fullChain = [...ids].reverse().map(id => nodes[parseInt(id)] || id).join(' ← ');
            return {
                label: leafName,
                tooltip: fullChain,
                onClick: () => {
                    const rowData = findTraceDataBySymbol(traceStr);
                    if (rowData && window.openTracePopup) {
                        const isExcl = getSectionInclExclIndex('top-traces') === 1;
                        window.openTracePopup(rowData, isExcl, {
                            items: dataArray,
                            currentIndex: index,
                            isExclusive: isExcl,
                            preSelectTrace: traceStr,
                        });
                    }
                },
            };
        });
    }

    function getSectionInclExclIndex(prefix) {
        const toggle = document.getElementById(`${prefix}-incl-excl-toggle`);
        return toggle && toggle.checked ? 1 : 0;
    }

    function updateSectionTables(prefix, diffsData, renderFn) {
        const idx = getSectionInclExclIndex(prefix);
        renderFn(`${prefix}-baseline`, diffsData[idx][0]);
        renderFn(`${prefix}-target`, diffsData[idx][1]);
        const toggle = document.getElementById(`${prefix}-common-sort-toggle`);
        if (toggle) {
            const isDescending = toggle.getAttribute('data-sort') === 'desc';
            renderFn(`${prefix}-common`, diffsData[idx][isDescending ? 2 : 3]);
        }
    }

    function onFunctionsInclExclToggle() {
        updateSectionTables('top-funcs', topFunctionDiffs, renderFunctionsTable);
    }

    function onTracesInclExclToggle() {
        updateSectionTables('top-traces', topTraceDiffs, renderTracesTable);
    }

    function toggleTable(id) {
        const toggle = document.getElementById(id + '-sort-toggle');
        if (!toggle) return;

        const currentSort = toggle.getAttribute('data-sort');
        const newSort = currentSort === 'desc' ? 'asc' : 'desc';

        toggle.setAttribute('data-sort', newSort);
        document.getElementById(id + '-sort-label').textContent = newSort === 'desc' ? 'Descending' : 'Ascending';
        document.getElementById(id + '-sort-arrow').textContent = newSort === 'desc' ? '▼' : '▲';

        if (id.startsWith('top-funcs')) {
            updateSectionTables('top-funcs', topFunctionDiffs, renderFunctionsTable);
        } else if (id.startsWith('top-traces')) {
            updateSectionTables('top-traces', topTraceDiffs, renderTracesTable);
        }
    }

    function initDiffTables() {
        updateSectionTables('top-funcs', topFunctionDiffs, renderFunctionsTable);
        updateSectionTables('top-traces', topTraceDiffs, renderTracesTable);
    }

    // Execute immediately after DOM is loaded or script runs
    document.addEventListener("DOMContentLoaded", initDiffTables);
    if (document.readyState === "complete" || document.readyState === "interactive") {
        initDiffTables();
    }
</script>