<script>
    {% if flamegraphs %}

        const LEFT_FLAMEGRAPH = "lhs";

        function cleanTitlePerl(title) {
            let index = title.search(/\(\d/);
            if (index !== -1) {
                title = title.slice(0, index) + '(';
            }
            return title;
        }

        function cleanTitlePython(title) {
            let index = title.search(/\n/);
            if (index !== -1) {
                title = title.slice(0, index) + '\n';
            }
            return title;
        }

        // Extract the canonical function name from a flame graph title (no trailing \n)
        function extractFuncName(title) {
            let index = title.search(/\n/);
            if (index !== -1) {
                return title.slice(0, index);
            }
            return title;
        }

        // =====================================================================
        //  Per-grid flame graph configuration
        // =====================================================================
        const FLAME_GRIDS = [
            {
                gridId: "graphs-diff",
                types: ["lhs_diff", "rhs_diff"],
                searchInputId: "diff_graph_search_all",
                searchResetBtnId: "diff_graph_search_reset_all",
                zoomResetBtnId: "diff_graph_zoom_reset_all",
                toggleIEBtnId: "diff_graph_toggle_ie_all",
            },
            {
                gridId: "graphs-nondiff",
                types: ["lhs", "rhs"],
                searchInputId: "nondiff_graph_search_all",
                searchResetBtnId: "nondiff_graph_search_reset_all",
                zoomResetBtnId: "nondiff_graph_zoom_reset_all",
                toggleIEBtnId: "nondiff_graph_toggle_ie_all",
            },
        ];

        {% for index in range(0, flamegraphs|length) %}

        FLAME_GRIDS.forEach(function (gridConfig) {
            const gridEl = document.getElementById(gridConfig.gridId);
            const searchBar = document.getElementById(gridConfig.searchInputId);
            const linkedHoverState = { term: null, sourceType: null, leaveTimer: null };

            // --- Grid-scoped flame graph hover ---
            function findLinkedFlamegraphHit(target) {
                let node = target;
                while (node && node.parentElement) {
                    for (const type of gridConfig.types) {
                        if (node.parentElement.id === `${type}_{{ index }}_frames`) {
                            const title = node.querySelector("title");
                            if (!title || !title.innerHTML) { return null; }
                            return { type, group: node, title };
                        }
                    }
                    node = node.parentElement;
                }
                return null;
            }

            function linkedResetFlameHoverAll() {
                gridConfig.types.forEach(function (type) {
                    const fn = window[`${type}_{{ index }}_reset_search_hover`];
                    if (typeof fn === "function") { fn(); }
                });
                linkedHoverState.term = null;
                linkedHoverState.sourceType = null;
            }

            function linkedApplyFlameHover(searchTerm, sourceType) {
                if (searchTerm === linkedHoverState.term &&
                    sourceType === linkedHoverState.sourceType) { return; }

                gridConfig.types.forEach(function (type) {
                    const fn = window[`${type}_{{ index }}_reset_search_hover`];
                    if (typeof fn === "function") { fn(); }
                });

                if (!searchTerm) {
                    linkedHoverState.term = null;
                    linkedHoverState.sourceType = null;
                    return;
                }

                linkedHoverState.term = searchTerm;
                linkedHoverState.sourceType = sourceType;

                gridConfig.types.forEach(function (type) {
                    const highlightFn = window[`${type}_{{ index }}_apply_hover_highlight`];
                    const statsFn = window[`${type}_{{ index }}_search_hover_show_stats`];
                    if (typeof highlightFn !== "function") { return; }
                    const res = highlightFn(searchTerm);
                    if (typeof statsFn === "function") { statsFn(res); }
                });
            }

            function cancelLinkedHoverLeave() {
                if (linkedHoverState.leaveTimer !== null) {
                    clearTimeout(linkedHoverState.leaveTimer);
                    linkedHoverState.leaveTimer = null;
                }
            }

            // --- Grid-scoped flame graph search ---
            function searchCallback() {
                let searchTerm = searchBar.value.trim();
                gridConfig.types.forEach(function (type) {
                    const resetFn = window[`${type}_{{ index }}_reset_search`];
                    if (typeof resetFn === "function") { resetFn(); }
                    if (searchTerm !== "") {
                        window[`${type}_{{ index }}_currentSearchTerm`] = searchBar.value;
                        const searchFn = window[`${type}_{{ index }}_search`];
                        if (typeof searchFn === "function") { searchFn(); }
                    }
                });
            }

            // --- Grid-scoped flame graph reset/toggle ---
            function resetFlamegraphAll(type) {
                gridConfig.types.forEach(function (variation) {
                    const id_clickable = `${variation}_{{ index }}_${type}`;
                    const element = document.getElementById(id_clickable);
                    if (!element) return;

                    if (type === "search") {
                        searchBar.value = "";
                        if (element.classList.contains("show")) {
                            element.dispatchEvent(new Event("click", { bubbles: true }));
                        }
                    } else if (type === "unzoom") {
                        if (!element.classList.contains("hide")) {
                            element.dispatchEvent(new Event("click", { bubbles: true }));
                        }
                    }
                });
            }

            function toggleAllFlamegraphs() {
                const toggleBtn = document.getElementById(gridConfig.toggleIEBtnId);
                let switch_from = "Show exclusive";
                if (toggleBtn.firstChild.nodeValue === "Show Exclusive Consumption") {
                    toggleBtn.firstChild.nodeValue = "Show Inclusive Consumption";
                } else {
                    toggleBtn.firstChild.nodeValue = "Show Exclusive Consumption";
                    switch_from = "Show inclusive";
                }

                gridConfig.types.forEach(function (variation) {
                    const id_clickable = `${variation}_{{ index }}_excToggle`;
                    const element = document.getElementById(id_clickable);
                    if (element && element.firstChild.nodeValue === switch_from) {
                        element.dispatchEvent(new Event("click", { bubbles: true }));
                    }
                });
            }

            // --- Determine the treemap grid instance for this flame grid ---
            const treemapGrid = gridConfig.gridId === "graphs-diff"
                ? window.diffTreemapGrid
                : window.nondiffTreemapGrid;

            // =====================================================================
            //  Unified hover delegation: flame graphs + tree maps within this grid
            // =====================================================================
            if (gridEl) {
                gridEl.addEventListener("mouseover", function (e) {
                    cancelLinkedHoverLeave();
                    if (treemapGrid) { treemapGrid.cancelHoverLeave(); }

                    // Check flame graph hit
                    const flameHit = findLinkedFlamegraphHit(e.target);
                    if (flameHit) {
                        const cleanedTitle = cleanTitlePython(flameHit.title.innerHTML);
                        const funcName = extractFuncName(flameHit.title.innerHTML);

                        // Highlight in flame graphs
                        linkedApplyFlameHover(cleanedTitle, flameHit.type);
                        // Highlight in tree maps
                        if (treemapGrid) { treemapGrid.enterHover(funcName); }
                        return;
                    }

                    // Check tree map hit
                    if (treemapGrid) {
                        const uid = treemapGrid.findTreemapLeafUid(e.target);
                        if (uid) {
                            // Highlight in tree maps
                            treemapGrid.enterHover(uid);
                            // Highlight in flame graphs (use uid + "\n" for startsWith matching)
                            linkedApplyFlameHover(uid + "\n", "treemap");
                            return;
                        }
                    }

                    // No hit — reset if we had something active
                    if (linkedHoverState.term !== null) {
                        linkedResetFlameHoverAll();
                    }
                    if (treemapGrid && treemapGrid.getActiveHoverUid() !== null) {
                        treemapGrid.flushActiveHover();
                    }
                });

                gridEl.addEventListener("mouseout", function (e) {
                    if (e.relatedTarget && gridEl.contains(e.relatedTarget)) { return; }

                    cancelLinkedHoverLeave();
                    linkedHoverState.leaveTimer = setTimeout(function () {
                        linkedHoverState.leaveTimer = null;
                        linkedResetFlameHoverAll();
                        if (treemapGrid) { treemapGrid.flushActiveHover(); }
                    }, 0);
                });

                // Per-frames mouseleave for flame graphs
                gridConfig.types.forEach(function (type) {
                    const framesEl = document.getElementById(`${type}_{{ index }}_frames`);
                    if (!framesEl) { return; }
                    framesEl.addEventListener("mouseleave", function (e) {
                        if (e.relatedTarget && framesEl.contains(e.relatedTarget)) { return; }
                        // Don't reset immediately — the pointer might be moving to a tree map
                        cancelLinkedHoverLeave();
                        linkedHoverState.leaveTimer = setTimeout(function () {
                            linkedHoverState.leaveTimer = null;
                            const el = document.elementFromPoint(e.clientX, e.clientY);
                            if (el && gridEl.contains(el)) {
                                // Check if now over another graph in this grid
                                if (findLinkedFlamegraphHit(el)) { return; }
                                if (treemapGrid && treemapGrid.findTreemapLeafUid(el)) { return; }
                            }
                            linkedResetFlameHoverAll();
                            if (treemapGrid) { treemapGrid.flushActiveHover(); }
                        }, 0);
                    });
                });
            }

            // =====================================================================
            //  Unified search: dispatches to both flame graphs and tree maps
            // =====================================================================
            if (searchBar) {
                searchBar.addEventListener('input', function () {
                    searchCallback();
                    const term = searchBar.value.trim();
                    if (treemapGrid) {
                        if (term) { treemapGrid.globalSearchApplyTerm(term); }
                        else { treemapGrid.globalSearchReset(gridConfig.searchInputId); }
                    }
                });
                searchBar.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        searchCallback();
                        const term = searchBar.value.trim();
                        if (treemapGrid) {
                            if (term) { treemapGrid.globalSearchApplyTerm(term); }
                            else { treemapGrid.globalSearchReset(gridConfig.searchInputId); }
                        }
                        this.blur();
                    }
                });
            }

            // --- Unified button bindings ---
            const resetSearchBtn = document.getElementById(gridConfig.searchResetBtnId);
            if (resetSearchBtn) {
                resetSearchBtn.addEventListener("click", function () {
                    resetFlamegraphAll("search");
                    if (treemapGrid) { treemapGrid.globalSearchReset(gridConfig.searchInputId); }
                });
            }

            const resetZoomBtn = document.getElementById(gridConfig.zoomResetBtnId);
            if (resetZoomBtn) {
                resetZoomBtn.addEventListener("click", function () {
                    resetFlamegraphAll("unzoom");
                });
            }

            const toggleIEBtn = document.getElementById(gridConfig.toggleIEBtnId);
            if (toggleIEBtn) {
                toggleIEBtn.addEventListener("click", function () {
                    toggleAllFlamegraphs();
                    if (treemapGrid) {
                        const metricBtnId = gridConfig.toggleIEBtnId;
                        treemapGrid.globalMetricToggle(metricBtnId);
                    }
                });
            }
        });

        {% endfor %}

    {% endif %}
</script>
