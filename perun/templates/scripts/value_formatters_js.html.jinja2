{%- macro tooltip(tooltip_text) %}<div class="hover-text">[?]<!-- Tooltip text --><span class="tooltip-text tright">{{
        tooltip_text }}</span></div>{%- endmacro %}

<script>
    function ensureNumber(val) {
        if (typeof val !== "number") {
            val = Number(val);
        }
        return val;
    }


    function formatNumber(num) {
        if (num === null || num === undefined || isNaN(num)) return num;

        const formatVal = (n) => {
            const absN = Math.abs(n);
            if (absN === 0) return "0.00";
            if (absN < 1) return n.toFixed(2);
            return n.toPrecision(3);
        };

        const absNum = Math.abs(num);
        if (absNum >= 1.0e12) {
            return formatVal(num / 1.0e12) + " T";
        } else if (absNum >= 1.0e9) {
            return formatVal(num / 1.0e9) + " G";
        } else if (absNum >= 1.0e6) {
            return formatVal(num / 1.0e6) + " M";
        } else if (absNum >= 1.0e3) {
            return formatVal(num / 1.0e3) + " K";
        } else {
            return formatVal(num);
        }
    }

    function formatDelta(data, suffix = '') {
        const num = parseFloat(data);
        if (isNaN(num)) return data;
        let color = 'var(--color-primary-text)';
        if (num > 0) color = 'var(--color-wrong)';
        else if (num <= 0) color = 'var(--color-correct)';
        
        const formatted = formatNumber(num);
        
        return `<span style="font-weight: bold; color: ${color}">${formatted}${suffix}</span>`;
    }

    function formatBold(data) {
        const num = parseFloat(data);
        const formatted = !isNaN(num) ? formatNumber(num) : data;
        return `<span style="font-weight: bold;">${formatted}</span>`;
    }


    function formatMs(ms) {
        ms = Math.abs(ms);
        let units = ["ms", "s", "min", "h"];
        let divs = [1000.0, 60.0, 60.0, 60.0];
        for (let i = 0; i < divs.length; i++) {
            let unit = units[i], div = divs[i];
            if (ms < div) {
                return `${ms.toFixed(2)} ${unit}`;
            }
            ms /= div;
        }
        return `${size.toFixed(2)} days`;
    }

    function formatSize(size, baseUnit = "") {
        if (typeof size !== "number") {
            size = Number(size);
        }
        let space = baseUnit !== "" ? " " : "";
        let units = ["", "k", "M", "G", "T"];
        for (let unit of units) {
            if (Math.abs(size) < 1000.0) {
                if (unit === "") {
                    return `${size.toFixed(2)}${space}${baseUnit}`;
                }
                return `${size.toFixed(2)}${space}${unit}${baseUnit}`;
            }
            size /= 1000.0;
        }
        return `${size.toFixed(2)} P${baseUnit}`;
    }

    function format(value, unit) {
        value = ensureNumber(value);
        if (unit === "ms") {
            return formatMs(value);
        } else if (unit === "%") {
            return `${value.toFixed(2)}%`;
        } else {
            return formatSize(value);
        }
    }

    function getColorForFreshness(fresh) {
        if (fresh === 'not in baseline') return 'var(--color-target)';
        if (fresh === 'not in target') return 'var(--color-baseline)';
        return 'var(--color-common)';
    }
</script>