<div id="trace-popup-container" style="display: none">
    <div class="note-overlay" onclick="closeTracePopup()"></div>

    <button id="trace-popup-prev" class="trace-popup-nav-btn trace-popup-nav-btn--prev" onclick="navigatePopup(-1)" title="Previous function (Left Arrow)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <button id="trace-popup-next" class="trace-popup-nav-btn trace-popup-nav-btn--next" onclick="navigatePopup(1)" title="Next function (Right Arrow)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>

    <div class="note-popup" id="trace-popup">

        <span id="trace-popup-close" onclick="closeTracePopup()">
            {% include 'assets/close.svg' %}
        </span>

        <div id="trace-popup-title-bar">
            <h2 id="trace-popup-title">Trace Details</h2>
            <div id="trace-popup-nav-badge" class="trace-popup-nav-badge" style="display: none;">
                <span id="trace-popup-nav-counter">1 / 20</span>
            </div>
        </div>

        <div id="trace-popup-content-wrapper">
            <div id="trace-popup-header">
                <span id="trace-info-text"></span>
            </div>

            <div id="trace-popup-body">
                <!-- Left: Trace Stats Table (Green Area) -->
                <div id="trace-stats-container">
                    <h3 id="trace-stats-heading">Trace Statistics</h3>
                    <div id="trace-details-table-container" style="display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden;"></div>
                </div>

                <!-- Right: Call Stack Visualization -->
                <div id="trace-callstack-panel">
                    <div id="trace-callstack-header">
                        <h3 id="trace-callstack-title">Call Stack</h3>
                    </div>
                    <p id="trace-callstack-hint">Click on a trace row to inspect its call chain</p>
                    <div id="trace-callstack-content"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPopupNavContext = null;

    function closeTracePopup() {
        document.getElementById('trace-popup-container').style.display = 'none';
        currentPopupNavContext = null;
    }

    function getRowDataFromNavContextItem(item) {
        if (!item) return null;
        if (item.uid && item.index) {
            return item;
        }
        if (Array.isArray(item) && window.tracesData) {
            const nodeIdStr = item[0].toString();
            return window.tracesData.find(r => r.index === nodeIdStr) || null;
        }
        return null;
    }

    function navigatePopup(direction) {
        if (!currentPopupNavContext || !currentPopupNavContext.items) return;

        const newIndex = currentPopupNavContext.currentIndex + direction;
        if (newIndex < 0 || newIndex >= currentPopupNavContext.items.length) return;

        const item = currentPopupNavContext.items[newIndex];
        const rowData = getRowDataFromNavContextItem(item);
        if (rowData) {
            openTracePopup(rowData, currentPopupNavContext.isExclusive, {
                ...currentPopupNavContext,
                currentIndex: newIndex
            });
        }
    }

    document.addEventListener('keydown', (event) => {
        const container = document.getElementById('trace-popup-container');
        if (container && container.style.display !== 'none') {
            if (event.key === 'Escape') {
                closeTracePopup();
            } else if (event.key === 'ArrowLeft') {
                event.preventDefault();
                navigatePopup(-1);
            } else if (event.key === 'ArrowRight') {
                event.preventDefault();
                navigatePopup(1);
            }
        }
    });

    function openTracePopup(rowData, isExclusive, navContext) {
        document.getElementById('trace-popup-container').style.display = 'flex';

        currentPopupNavContext = navContext || null;

        const prevBtn = document.getElementById('trace-popup-prev');
        const nextBtn = document.getElementById('trace-popup-next');
        const navBadge = document.getElementById('trace-popup-nav-badge');
        const counterSpan = document.getElementById('trace-popup-nav-counter');

        if (currentPopupNavContext && currentPopupNavContext.items && currentPopupNavContext.items.length > 1) {
            const total = currentPopupNavContext.items.length;
            const curIdx = currentPopupNavContext.currentIndex;

            if (prevBtn) {
                prevBtn.style.display = 'flex';
                prevBtn.disabled = curIdx <= 0;
            }
            if (nextBtn) {
                nextBtn.style.display = 'flex';
                nextBtn.disabled = curIdx >= total - 1;
            }
            if (navBadge) {
                navBadge.style.display = 'inline-flex';
                if (counterSpan) counterSpan.textContent = `${curIdx + 1} / ${total}`;
            }
        } else {
            if (prevBtn) prevBtn.style.display = 'none';
            if (nextBtn) nextBtn.style.display = 'none';
            if (navBadge) navBadge.style.display = 'none';
        }

        // Populate Header
        const popupTitle = document.getElementById('trace-popup-title');
        popupTitle.innerHTML = '';

        const titleText = document.createElement('span');
        titleText.className = 'trace-popup-title-text';
        titleText.innerHTML = `Unit: ${rowData.uid} <span style="font-weight: bold; color: ${getColorForFreshness(rowData.fresh)}">(${rowData.fresh})</span>`;
        popupTitle.appendChild(titleText);

        if (rowData.uid) {
            const copyTitleBtn = createCopyButton(rowData.uid, 'trace-popup-title-copy-btn');
            copyTitleBtn.title = 'Copy function name';
            popupTitle.appendChild(copyTitleBtn);
        }
        document.getElementById('trace-info-text').innerHTML = `
            <div class="trace-header-stats">
                <div class="stat-item stat-item-aligned-end">
                    <span class="stat-label">Total Unit Consumption</span>
                    <span class="stat-value" id="stat-value-incl-label" style="font-weight: bold;">Inclusive: </span>
                    <span class="stat-value" id="stat-value-excl-label" style="font-weight: bold;">Exclusive: </span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Baseline:</span>
                    <span class="stat-value">${formatBold(rowData.baseline_abs_incl)}</span>
                    <span class="stat-value">${formatBold(rowData.baseline_abs_excl)}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Target:</span>
                    <span class="stat-value">${formatBold(rowData.target_abs_incl)}</span>
                    <span class="stat-value">${formatBold(rowData.target_abs_excl)}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Prop Δ:</span>
                    <span class="stat-value">${formatDelta(rowData.prop_rel_delta_incl, '%')}</span>
                    <span class="stat-value">${formatDelta(rowData.prop_rel_delta_excl, '%')}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Abs Δ:</span>
                    <span class="stat-value">${formatDelta(rowData.abs_delta_incl)}</span>
                    <span class="stat-value">${formatDelta(rowData.abs_delta_excl)}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Rel Δ:</span>
                    <span class="stat-value">${formatDelta(rowData.rel_delta_incl, '%')}</span>
                    <span class="stat-value">${formatDelta(rowData.rel_delta_excl, '%')}</span>
                </div>
            </div>
        `;

        const containerId = 'trace-details-table-container';
        document.getElementById(containerId).innerHTML = '';

        // Set context based on whether we are displaying inclusive or exclusive data.
        let labelElement;
        let tracesType;
        // The trace_stats contain both inclusive and exclusive metrics. The exclusive counterpart
        // for an inclusive metric is always at a +1 offset within the array.
        let dataOffset;
        if (isExclusive) {
            labelElement = document.getElementById('stat-value-excl-label');
            tracesType = "Exclusive";
            dataOffset = 1;
        } else {
            labelElement = document.getElementById('stat-value-incl-label');
            tracesType = "Inclusive";
            dataOffset = 0;
        }
        // Emphasize the type of data this modal window is currently displaying.
        labelElement.style.color = 'var(--color-info)';

        let traceDetailTitle = '';
        if (rowData.trace_stats && rowData.trace_stats.length > 0) {
            traceDetailTitle = `Top ${Math.min(rowData.trace_stats.length, {{ max_traces_per_func }})} ${tracesType} Traces`;
        } else {
            traceDetailTitle = 'No traces available';

        }
        document.getElementById('trace-stats-heading').textContent = traceDetailTitle;

        // Decodes and formats the stack trace string in a format 'id1;id2;id3;[...]#[...]'.
        function decodeStackTrace(trace) {
            if (!trace) return "";

            // Ignore everything after the '#'
            const funcIds = trace.split('#')[0];
            const funcNames = funcIds
                .split(';')
                .map(id => Number(id))
                .reverse()  // Reverse the order to be consistent with the flamegraph visualization.
                .map(id => nodes[id] ?? `[unknown:${id}]`) // Map to names.
            // Make the function at the top bold.
            return funcNames
                .map((name, index) => index === 0 ? `<b>${name}</b>` : name)
                .join('\n');
        }


        // Sort the list of traces based on the initial sort column.
        const initSortColumn = 6 + dataOffset;
        rowData.trace_stats.sort((a, b) => {
            return b[initSortColumn] - a[initSortColumn];
        });

        // Decodes the stack trace string in a format 'id1;id2;id3;[...]#[...]'.
        // Returns an array of function name strings, from top-of-stack (callee) to bottom (root caller).
        function decodeStackTraceNames(trace) {
            if (!trace) return [];
            const funcIds = trace.split('#')[0];
            return funcIds
                .split(';')
                .map(id => Number(id))
                .reverse()  // Reverse so index 0 = top of stack (the target function).
                .map(id => nodes[id] ?? `[unknown:${id}]`);
        }

        // Returns the function name at index 0 of the decoded call chain (the profiled/observed function).
        function getTopFunctionName(trace) {
            const names = decodeStackTraceNames(trace);
            return names.length > 0 ? names[0] : '';
        }

        // Renders the call-stack panel on the right for a given trace row and marks its tr as selected.
        function renderCallStack(row, tr) {
            // Update selected row highlight
            if (selectedTr) selectedTr.classList.remove('trace-row--selected');
            if (tr) {
                tr.classList.add('trace-row--selected');
                selectedTr = tr;
            }

            // row[12] is the full encoded call chain (e.g. "12;178;2#0;0;0#0;0;0").
            const names = decodeStackTraceNames(row[12]);
            const panel = document.getElementById('trace-callstack-content');
            const hint = document.getElementById('trace-callstack-hint');
            hint.style.display = 'none';

            if (!names.length) {
                panel.innerHTML = '<p style="color: var(--color-bs-secondary); font-style: italic;">No call stack available.</p>';
                return;
            }

            const totalDepth = names.length;
            panel.innerHTML = '';

            names.forEach((name, i) => {
                const isFocus = i === 0;  // The observed/profiled function in this trace scope
                const isRoot = i === totalDepth - 1;  // The root caller within this scope

                const frame = document.createElement('div');
                frame.className = 'callstack-frame' + (isFocus ? ' callstack-frame--focus' : '') + (isRoot ? ' callstack-frame--root' : '');

                const depthLabel = document.createElement('span');
                depthLabel.className = 'callstack-depth';
                if (isFocus) {
                    depthLabel.textContent = "LEAF";
                } else if (isRoot) {
                    depthLabel.textContent = 'ROOT';
                } else {
                    depthLabel.textContent = `${i}`;
                }
                frame.appendChild(depthLabel);

                const funcName = document.createElement('span');
                funcName.className = 'callstack-funcname';
                funcName.textContent = name;
                frame.appendChild(funcName);

                const copyBtn = createCopyButton(name, 'callstack-copy-btn');
                copyBtn.title = 'Copy function name';
                frame.appendChild(copyBtn);

                panel.appendChild(frame);

                // Arrow connector between frames (not after the last one)
                if (i < totalDepth - 1) {
                    const connector = document.createElement('div');
                    connector.className = 'callstack-connector';
                    connector.innerHTML = '<span class="callstack-arrow">&#8593;</span>';
                    panel.appendChild(connector);
                }
            });
        }

        // Reset the callstack panel and selected row tracking
        document.getElementById('trace-callstack-content').innerHTML = '';
        document.getElementById('trace-callstack-hint').style.display = '';
        let selectedTr = null;

        if (rowData.trace_stats && rowData.trace_stats.length > 0) {

            // Assign index (1-based) and trace depth (number of frames) to each row
            rowData.trace_stats.forEach((row, i) => {
                row[13] = i + 1;
                const traceStr = row[12];
                row[14] = traceStr ? traceStr.split('#')[0].split(';').length : 0;
            });

            const columns = [
                {
                    data: 13,
                    title: 'Idx',
                    filterable: false,
                    render: (data) => {
                        return `<div class="trace-cell-compact trace-cell-clickable" title="Click to view call chain">${data}</div>`;
                    },
                    width: '60px',
                    tooltip: TRACES_TOOLTIPS.index
                },
                {
                    data: 14,
                    title: 'Depth',
                    type: 'number',
                    filterable: false,
                    render: (data) => `<div class="trace-cell-compact">${data}</div>`,
                    width: '85px',
                    tooltip: TRACES_TOOLTIPS.depth
                },
                {
                    data: 2 + dataOffset,
                    title: 'Baseline',
                    type: 'number',
                    render: (data) => formatBold(data),
                    tooltip: TRACES_TOOLTIPS.baseline
                },
                {
                    data: 4 + dataOffset,
                    title: 'Target',
                    type: 'number',
                    render: (data) => formatBold(data),
                    tooltip: TRACES_TOOLTIPS.target
                },
                {
                    data: 6 + dataOffset,
                    title: 'Prop Δ [%]',
                    type: 'number',
                    render: (data) => formatDelta(data, '%'),
                    tooltip: TRACES_TOOLTIPS.prop_rel_delta
                },
                {
                    data: 8 + dataOffset,
                    title: 'Abs Δ',
                    type: 'number',
                    render: (data) => formatDelta(data),
                    tooltip: TRACES_TOOLTIPS.abs_delta
                },
                {
                    data: 10 + dataOffset,
                    title: 'Rel Δ [%]',
                    type: 'number',
                    render: (data) => formatDelta(data, '%'),
                    tooltip: TRACES_TOOLTIPS.rel_delta
                }
            ];

            const tracesTableInstance = new TracesTable(containerId, {
                data: rowData.trace_stats,
                columns: columns,
                enablePagination: false,
                enableFilters: false,
                initialSortColumn: initSortColumn,
                initialSortDirection: 'desc',
                onRowClick: (row, tr) => {
                    renderCallStack(row, tr);
                }
            });

            // Auto-select the first displayed row
            if (tracesTableInstance.processedData.length > 0) {
                const firstTr = document.querySelector(`#${containerId} tbody tr`);
                renderCallStack(tracesTableInstance.processedData[0], firstTr);
            }
        } else {
            document.getElementById(containerId).innerHTML = '<div style="text-align: center; padding: 10px;">No trace statistics available.</div>';
        }
    }
</script>