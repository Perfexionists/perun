{% set STATS_NOTE_TITLE = "profile statistics" %}

<div id="profile-stats" class="section">

    {{ property_generator.display_title("Profile Statistics", "profile statistics", notes_enabled=notes_enabled) }}

    <div class="comparison_container">
        {{ property_generator.general_comparison_container('baseline', STATS_NOTE_TITLE, lhs_fg_stats, notes_enabled) }}
        {{ property_generator.general_comparison_container('target', STATS_NOTE_TITLE, rhs_fg_stats, notes_enabled) }}
    </div>

    <div class="comparison_container">
        {% if lhs_stats %}
        {{ property_generator.general_comparison_container('baseline', STATS_NOTE_TITLE, lhs_user_stats, notes_enabled) }}
        {% endif %}

        {% if rhs_stats %}
        {{ property_generator.general_comparison_container('target', STATS_NOTE_TITLE, rhs_user_stats, notes_enabled) }}
        {% endif %}
    </div>
</div>