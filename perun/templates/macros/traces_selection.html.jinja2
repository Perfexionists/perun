{% macro empty_table(title, id) %}
    <div class="column top-traces-column">
        <h2 style="margin-bottom: 20px;">{{ title }}</h2>
        <div id="{{ id }}" style="max-height: 250px; overflow-y: auto; padding-right: 5px;">
            <!-- Content filled dynamically by JS -->
        </div>
    </div>
{% endmacro %}

{% macro empty_table_switchable(title, id) %}
    <div class="column top-traces-column">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="margin: 0;">{{ title }}</h2>
            <div id="{{ id }}-sort-toggle" class="sort-toggle" onclick="toggleTable('{{ id }}')" data-sort="desc" style="cursor: pointer; font-size: 14px; display: flex; align-items: center; gap: 4px;">
                <span id="{{ id }}-sort-label">Descending</span>
                <span id="{{ id }}-sort-arrow" style="color: var(--color-target); font-size: 0.8em;">▼</span>
            </div>
        </div>
        <div id="{{ id }}" style="max-height: 250px; overflow-y: auto; padding-right: 5px;">
            <!-- Content filled dynamically by JS -->
        </div>
    </div>
{% endmacro %}